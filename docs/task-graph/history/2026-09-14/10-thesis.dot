digraph thesis {
  graph [rankdir=BT, label="10 / thesis candidate pipeline", labelloc=t];
  node [shape=box];
  done [label="OUTCOME: defensible PDF\n+ residual-risk report"];
  human [label="CRUX: Jorn full read\nsee 12-review", shape=diamond];
  candidate [label="OUTCOME: checked candidate"];
  findings [label="CRUX: review findings\nsee 11-content", shape=diamond];
  reviews [label="DONE: Sol + Astra diagnostics;\nAstra reviewed with Jorn"];
  build [label="Fresh build + render inspection\nroutine; ready; root"];
  draft [label="INPUT: complete ~110-page draft\nlast recorded build 2026-09-11"];
  draft -> build -> reviews -> findings -> candidate -> human -> done;
}
