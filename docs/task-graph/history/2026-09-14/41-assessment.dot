digraph assessment {
  graph [rankdir=BT, label="41 / external assessment outcomes", labelloc=t];
  node [shape=box];
  assess [label="CRUX: examiner assessment", shape=diamond];
  pass [label="FINAL: PASS"];
  revise [label="OUTCOME: revise/resubmit"];
  fail [label="OUTCOME: fail\nnext route determined"];
  candidate [label="INPUT: valid submission"];
  candidate -> assess;
  assess -> pass [label="pass"];
  assess -> revise [label="revision allowed"];
  assess -> fail [label="fail"];
  revise -> candidate;
}
