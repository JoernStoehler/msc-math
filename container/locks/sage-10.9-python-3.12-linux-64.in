# Source constraints for the adjacent explicit realization.
#
# Resolve on an x86-64-v3 Linux host with the Miniforge version pinned in the
# Dockerfile. Because conda-forge is live, regeneration is an intentional lock
# refresh and need not reproduce an older explicit file byte-for-byte:
#
#   export CONDA_OVERRIDE_ARCHSPEC=x86_64_v3
#   mamba create -y -n msc-math-sage-lock --channel conda-forge \
#     --strict-channel-priority --file container/locks/sage-10.9-python-3.12-linux-64.in
#   conda list -n msc-math-sage-lock --explicit > \
#     container/locks/sage-10.9-python-3.12-linux-64.explicit
#   conda env remove -n msc-math-sage-lock

python=3.12
sage=10.9
