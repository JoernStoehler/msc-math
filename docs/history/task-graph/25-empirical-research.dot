digraph empirical_research {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.55",
    label="Empirical research: reviewed results and continuation rules\nFirst windows and selected follow-ups complete; general zonotope bound remains open",
    labelloc=t, fontname="sans-serif", fontsize=17];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#47627a", fontname="sans-serif", fontsize=12, margin="0.15,0.1"];
  edge [fontname="sans-serif", fontsize=10, color="#65798b"];
  context [label="DONE: shared observations + toolbox\nDefinitions, prior negatives, source paths\nNative data; no forced rectangular schema", fillcolor="#e9f4e6"];
  root [label="DONE: root review + follow-ups\n11 replay checks passed; evidence committed\nNovelty remains unassessed", fillcolor="#dcebf8", penwidth=2];
  subgraph cluster_owners {
    label="Research owners: choose → investigate → interpret → revise";
    color="#bac9d4"; style=rounded;
    repr [label="DONE: complementary generic 4D data\nbroad_discovery_agenda\nPairings / polar / bulk representations"];
    methods [label="DONE: bounds + adverse examples\nretained_mechanisms\nRelations, regimes, separating examples"];
    pent [label="DONE: symmetric partners + blind directions\npentagon_partner_research\nHeterogeneous shapes + responses"];
    zono [label="OPEN BOUND; scalar attack PAUSED\ntoolbox_brainstorm\nSegment operations + interactions"];
    position [label="DONE: initial regime + failed lift criterion\nproduct_position_research\nSymplectic ↔ Lagrangian geometry"];
  }
  context -> repr;
  context -> pent;
  context -> zono;
  context -> position;
  context -> methods;
  repr -> methods [style=dashed, label="incremental definitions/data"];
  pent -> methods [style=dashed];
  zono -> methods [style=dashed];
  position -> methods [style=dashed];
  methods -> repr [style=dashed, label="missing information / adverse examples", constraint=false];
  methods -> pent [style=dashed, constraint=false];
  methods -> zono [style=dashed, constraint=false];
  methods -> position [style=dashed, constraint=false];
  repr -> root [label="evidence + judgment"];
  pent -> root;
  zono -> root;
  position -> root;
  methods -> root;
  outcome [shape=diamond, style=filled, fillcolor="#fff1cf", label="NEXT DECISION:\nnew unresolved distinction?", fontsize=12];
  root -> outcome [penwidth=2];
  claim [label="READY WHEN JUSTIFIED:\nindependent check / derivation\nnew statement or construction", fillcolor="#e9f4e6"];
  revise [label="USEFUL PARTIAL:\nmissing variable or domain\nchange representation / sampling"];
  retire [label="INVALIDATED ROUTE:\nknown identity / source artifact\nrecord negative; redirect or stop", fillcolor="#fae8e5"];
  partial [label="WINDOW ENDS / BLOCKER:\nretain partial evidence + exact crux\nchoose bounded continuation"];
  outcome -> claim [label="consequential candidate"];
  outcome -> revise [label="informative distinction"];
  outcome -> retire [label="premise fails"];
  outcome -> partial [label="unresolved"];
  taste [label="Jörn: only consequential taste / scope choices\nConcrete finding + our judgment + follow-up cost", fillcolor="#f0eafa"];
  claim -> taste [style=dashed, label="when interest controls substantial work"];
  partial -> taste [style=dashed];
  revise -> root [style=dashed, constraint=false, label="continue without global barrier"];
}
