digraph now {
 graph [rankdir=TB,label="Parallel work now → first whole review — 15:57 UTC",labelloc=t,bgcolor="transparent"];
 node [shape=box,style="rounded,filled",fillcolor="#edf4fa",fontname="Helvetica",fontsize=11]; edge [fontname="Helvetica",fontsize=10];
 human [label="DS v2 desk-rejected at opening\nAI feedback / revision separate\nNo whole-reading request yet"];
 synthesis [label="hko_context + submission_surface\nSummaries / consistency\nFinal fixed-PDF delta checked"];
 build [label="candidate_integrator\nWhole PDF, guide, checks\nVisual + synthesis checks complete"];
 publish [label="pm_review\nDirect artifact handoff → index\nWithin 2 min; no root packaging"];
 read [shape=diamond,label="Whole-PDF judgment only after\nacceptable DS exposition\n90–150m active estimate; uncertain",fillcolor="#fff0d2"];
 authors [label="thesis_reader / ds_reader / specialist\nRepair concrete findings as they arrive\nIndependent check of substantive fixes"];
 root [label="Root: dialogue, priorities, decisions\nNo build / packaging / PM writing\nIdle not measured; only ~161s explicit waits"];
 end [label="20:30 checkpoint\nMinor final repairs → delivery by 22:00\nMajor unresolved failure → deadline risk",fillcolor="#fff0d2"];
 {rank=same;human;synthesis;build;root;}
 synthesis -> build [label="summary delta"]; build -> publish; publish -> read;
 human -> authors [label="findings"]; authors -> read [label="acceptable DS exposition"];
 authors -> build [label="revised snapshot"]; read -> authors [label="defects"]; read -> end [label="verdict / remaining scope"];
 root -> authors [style=dashed,label="consequential prioritization"];
}
