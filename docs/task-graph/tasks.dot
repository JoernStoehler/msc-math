digraph tasks {
  graph [rankdir=BT, label="Thesis outcomes: prepared baseline, pending integration", labelloc=t];
  node [shape=box];
  pass [label="OUTCOME: whole-thesis PASS\nrequires Jorn's explicit judgment"];
  draft [label="DONE: recovered frozen baseline\nsource and review evidence preserved\nprior whole-thesis judgment: FAIL"];
  conditional [label="READY: literature + pentagon drafts\nseparate candidates, not integrated"];
  route [label="READY: integration and remaining repairs\nsee 00-now and kickoff packet\nno new sprint or deadline started"];
  human [label="CRUX: whole-thesis reading\nfixed assembled PDF required", shape=diamond];
  history [label="HISTORY: prior portfolio components\nhistory/2026-09-14/\nstale assignments are not live work"];
  draft -> route;
  conditional -> route;
  history -> route [style=dashed, label="retained context"];
  route -> human [label="assembled candidate"];
  human -> pass [label="PASS"];
  human -> route [label="remaining objections"];
}
