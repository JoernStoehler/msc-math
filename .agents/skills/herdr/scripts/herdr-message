#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: herdr-message [--dry-run] TARGET (--file PATH | --stdin | -- TEXT...)' >&2
  exit 2
}

dry_run=false
if [[ ${1:-} == --dry-run ]]; then
  dry_run=true
  shift
fi

target=${1:-}
[[ -n $target ]] || usage
shift

case ${1:-} in
  --file)
    [[ $# == 2 && -f ${2:-} ]] || usage
    body=$(<"$2")
    ;;
  --stdin)
    [[ $# == 1 ]] || usage
    body=$(cat)
    ;;
  --)
    shift
    (($# > 0)) || usage
    body=$*
    ;;
  *) usage ;;
esac

[[ ${HERDR_ENV:-} == 1 ]] || {
  printf 'herdr-message: not running inside a Herdr pane\n' >&2
  exit 1
}
[[ -n ${HERDR_PANE_ID:-} ]] || {
  printf 'herdr-message: HERDR_PANE_ID is missing\n' >&2
  exit 1
}
command -v herdr >/dev/null || {
  printf 'herdr-message: herdr is not in PATH\n' >&2
  exit 1
}
command -v jq >/dev/null || {
  printf 'herdr-message: jq is not in PATH\n' >&2
  exit 1
}

self=$(herdr agent get "$HERDR_PANE_ID")
agent=$(jq -er '.result.agent.agent_session.agent // empty' <<<"$self") || {
  printf 'herdr-message: current pane has no durable agent session identity\n' >&2
  exit 1
}
kind=$(jq -er '.result.agent.agent_session.kind // empty' <<<"$self") || {
  printf 'herdr-message: current agent session has no identity kind\n' >&2
  exit 1
}
value=$(jq -er '.result.agent.agent_session.value // empty' <<<"$self") || {
  printf 'herdr-message: current agent session has no identity value\n' >&2
  exit 1
}

case "$agent:$kind" in
  codex:id) source="codex:thread:$value" ;;
  *:id)     source="$agent:session:$value" ;;
  *:path)   source="$agent:session-path:$value" ;;
  *)
    printf 'herdr-message: unsupported agent session identity %s:%s\n' \
      "$agent" "$kind" >&2
    exit 1
    ;;
esac
via="herdr:pane:$HERDR_PANE_ID"

xml_escape() {
  jq -Rs -r '@html'
}

source_escaped=$(printf '%s' "$source" | xml_escape)
via_escaped=$(printf '%s' "$via" | xml_escape)
body_escaped=$(printf '%s' "$body" | xml_escape)
payload=$(printf '<agent-message source="%s" via="%s">\n%s\n</agent-message>' \
  "$source_escaped" "$via_escaped" "$body_escaped")

if $dry_run; then
  printf '%s\n' "$payload"
else
  herdr agent prompt "$target" "$payload"
fi
