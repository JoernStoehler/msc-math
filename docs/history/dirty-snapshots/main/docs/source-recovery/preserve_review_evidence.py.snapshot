#!/usr/bin/env python3
"""Verify the bounded review/feedback copies against their checksum map.

The original hidden copies were retired after this manifest was created. The
historical ``old`` paths remain in the manifest as provenance; verification now
checks the ordinary evidence store that future readers use.
"""
import hashlib
import json
from pathlib import Path

root = Path(__file__).resolve().parents[2]
manifest = root / "docs/review-evidence/manifest.json"
records = json.loads(manifest.read_text())

for record in records:
    target = root / record["new"]
    if not target.is_file():
        raise FileNotFoundError(f"Missing preserved evidence: {target}")
    data = target.read_bytes()
    if len(data) != record["bytes"]:
        raise RuntimeError(f"Size mismatch for preserved evidence: {target}")
    digest = hashlib.sha256(data).hexdigest()
    if digest != record["sha256"]:
        raise RuntimeError(f"Checksum mismatch for preserved evidence: {target}")

print(json.dumps({"files": len(records),
                  "bytes": sum(record["bytes"] for record in records),
                  "status": "verified"}))
