{
  // Local devcontainer for msc-math (Jörn's Ubuntu desktop).
  // PRIMARY ENVIRONMENT.
  //
  // Features:
  // - Bind mounts for cache persistence (uv, TeX)
  // - Bind mounts for OAuth persistence (gh, claude, vscode tunnel)
  // - Full TexLive installation for PDF builds
  //
  // Prerequisites on host:
  // - /srv/devhome/ directories exist
  // - devcontainer CLI: npm i -g @devcontainers/cli
  //
  // Usage from host:
  //   .devcontainer/host-devcontainer-rebuild.sh
  //   .devcontainer/host-vscode-tunnel.sh
  "name": "msc-math-local",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/workspaces/msc-math",
  "updateRemoteUserUID": true,
  "features": {},
  // Memory limit: 10GB RAM + 2GB swap max. Protects host from runaway processes.
  // Container survives OOM; only the offending process is killed.
  // --memory-swap is total (RAM+swap), so 12g-10g = 2GB swap allowed.
  // --cap-add=SYS_ADMIN: needed for perf, strace, and other profiling tools inside the container.
  "runArgs": ["--memory=10g", "--memory-swap=12g", "--cap-add=SYS_ADMIN"],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "containerEnv": {
    "TERM": "xterm-256color",
    "LANG": "en_US.UTF-8",
    "DEVCONTAINER_ENV": "local",
    "HISTFILE": "/home/vscode/.bash_history_dir/.bash_history",
    "CARGO_BUILD_JOBS": "4",
    // Claude Code stores .claude.json at $CLAUDE_CONFIG_DIR (default: $HOME).
    // Must point inside ~/.claude/ so it's included in the bind mount.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Store VS Code tunnel auth in files instead of system keychain (persisted via ~/.vscode bind mount)
    "VSCODE_CLI_USE_FILE_KEYCHAIN": "1"
  },
  // Bind mounts: Jörn's specific host paths for cache persistence.
  "mounts": [
    "source=/srv/devhome/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    // Codex CLI auth + runtime state (mirrors the ~/.claude pattern).
    // Keeps auth.json, history.jsonl, sessions/, and log/ outside any git tree
    // so they can't be accidentally committed. User/IDE settings stay in the
    // mounted ~/.codex/config.toml; project agents and reusable skills live in
    // `.codex/agents/` and `.agents/skills/`.
    "source=/srv/devhome/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=/srv/devhome/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=/srv/devhome/.cache/uv,target=/home/vscode/.cache/uv,type=bind,consistency=cached",
    "source=/srv/devhome/.texlive2023,target=/home/vscode/.texlive2023,type=bind,consistency=cached",
    "source=/srv/devhome/.texmf-var,target=/home/vscode/.texmf-var,type=bind,consistency=cached",
    "source=/srv/devhome/.texmf-config,target=/home/vscode/.texmf-config,type=bind,consistency=cached",
    "source=/srv/devhome/.bash_history_dir,target=/home/vscode/.bash_history_dir,type=bind,consistency=cached",
    "source=msc-math-vscode,target=/home/vscode/.vscode,type=volume"
  ]
}
