#!/usr/bin/env python3

"""Serve an explicit set of local artifacts for short-lived browser review."""

import html
import json
import mimetypes
import pathlib
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote, urlsplit


STYLE = """
<style>
  :root { color-scheme: light dark; }
  body {
    box-sizing: border-box;
    max-width: 860px;
    margin: 2.5rem auto;
    padding: 0 2rem 4rem;
    color: light-dark(#202124, #e8eaed);
    background: light-dark(#fff, #202124);
    font: 16px/1.55 system-ui, sans-serif;
  }
  nav {
    position: sticky;
    top: 0;
    padding: .65rem 0;
    border-bottom: 1px solid light-dark(#dadce0, #5f6368);
    background: light-dark(#fff, #202124);
  }
  nav a { margin-right: 1rem; }
  h1, h2, h3 { line-height: 1.25; }
  pre, code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
  pre {
    padding: 1rem;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    border-radius: 6px;
    background: light-dark(#f6f8fa, #292a2d);
  }
</style>
"""


def index_page(state: dict) -> bytes:
    rows = []
    for item in sorted(state["files"], key=lambda entry: entry["shared_at"], reverse=True):
        name = html.escape(item["name"])
        target = f"/files/{item['id']}/{quote(item['name'], safe='')}"
        rows.append(f'<li><a href="{target}">{name}</a> '
                    f'<small>shared <time data-age="{item["shared_at"]}"></time></small></li>')
    document = (
        '<!doctype html><html><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">'
        '<meta http-equiv="refresh" content="30">'
        f'<title>Review files</title>{STYLE}'
        '<style>li {margin: 1rem 0} small {color: #777; white-space: nowrap} '
        'a {overflow-wrap: anywhere}</style></head><body>'
        '<h1>Review files</h1><p>Named files shared for review. This page refreshes automatically.</p>'
        f'<ul>{"".join(rows)}</ul>'
        f'<p>Available until <time data-expiry="{state["expires_at"]}"></time>.</p>'
        '<script>function update(){const now=Date.now()/1000;'
        'document.querySelectorAll("[data-age]").forEach(e=>{'
        'const s=Math.max(0,Math.floor(now-Number(e.dataset.age)));'
        'e.textContent=s<60?s+" sec ago":s<3600?Math.floor(s/60)+" min ago":Math.floor(s/3600)+" hr ago"});'
        'document.querySelectorAll("[data-expiry]").forEach(e=>'
        'e.textContent=new Date(Number(e.dataset.expiry)*1000).toLocaleString())}'
        'update();setInterval(update,10000)</script></body></html>'
    )
    return document.encode()


def markdown_page(path: pathlib.Path, raw: bool) -> bytes:
    source = path.read_text(encoding="utf-8")
    title = html.escape(path.name)
    nav = '<nav><a href="?">Rendered</a><a href="?raw=1">Raw source</a></nav>'
    if raw:
        document = (
            f"<!doctype html><html><head><meta charset='utf-8'>"
            f"<title>Raw — {title}</title>{STYLE}</head>"
            f"<body>{nav}<pre>{html.escape(source)}</pre></body></html>"
        )
        return document.encode()

    rendered = subprocess.run(
        [
            "pandoc",
            "--standalone",
            "--from=gfm-raw_html",
            "--to=html5",
            "--metadata",
            f"title={path.name}",
            str(path),
        ],
        check=True,
        stdout=subprocess.PIPE,
    ).stdout.decode("utf-8")
    rendered = rendered.replace("</head>", STYLE + "</head>")
    rendered = rendered.replace("<body>", "<body>" + nav, 1)
    return rendered.encode()


class Handler(BaseHTTPRequestHandler):
    files: list[pathlib.Path] = []
    token = ""
    manifest = None

    def do_GET(self) -> None:
        self.serve()

    def do_HEAD(self) -> None:
        self.serve(head=True)

    def serve(self, head=False) -> None:
        request = urlsplit(self.path)
        parts = request.path.strip("/").split("/")
        if self.manifest is not None:
            try:
                state = json.loads(self.manifest.read_text())
            except (OSError, ValueError):
                self.send_error(503)
                return
            if time.time() >= state["expires_at"]:
                self.send_error(410, "Review session expired")
                return
            if request.path == "/health":
                self.respond(state["session"].encode(), "text/plain", head=head)
                return
            if request.path == "/":
                self.respond(index_page(state), "text/html; charset=utf-8", head=head)
                return
            entry = next((item for item in state["files"]
                          if request.path == f"/files/{item['id']}/{quote(item['name'], safe='')}"), None)
            if entry is None:
                self.send_error(404)
                return
            path = pathlib.Path(entry["path"])
            display_name = entry["name"]
        else:
            if parts == [self.token, "health"]:
                self.send_response(204)
                self.end_headers()
                return
            if len(parts) != 2 or parts[0] != self.token or not parts[1].isdigit():
                self.send_error(404)
                return
            index = int(parts[1])
            if index >= len(self.files):
                self.send_error(404)
                return
            path = self.files[index]
            display_name = path.name
        suffix = path.suffix.lower()
        try:
            if suffix in {".md", ".markdown"}:
                body = markdown_page(path, "raw" in parse_qs(request.query))
                mime = "text/html; charset=utf-8"
            else:
                body = path.read_bytes()
                mime = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
                if mime.startswith("text/"):
                    mime += "; charset=utf-8"
        except (OSError, UnicodeError, subprocess.SubprocessError) as error:
            self.send_error(500, "Unable to read the shared artifact")
            return

        self.respond(body, mime, display_name, head)

    def respond(self, body, mime, name=None, head=False):
        self.send_response(200)
        self.send_header("Content-Type", mime)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        if name:
            self.send_header("Content-Disposition", "inline; filename*=UTF-8''" + quote(name, safe=""))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        if not head:
            self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        pass


def main() -> None:
    if len(sys.argv) == 5 and sys.argv[1] == "--manifest":
        Handler.manifest = pathlib.Path(sys.argv[2]).resolve(strict=True)
        ThreadingHTTPServer((sys.argv[3], int(sys.argv[4])), Handler).serve_forever()
        return
    if len(sys.argv) < 5:
        raise SystemExit("usage: review-server BIND_ADDRESS PORT TOKEN FILE...")
    bind_address = sys.argv[1]
    port = int(sys.argv[2])
    Handler.token = sys.argv[3]
    Handler.files = [pathlib.Path(name).resolve(strict=True) for name in sys.argv[4:]]
    ThreadingHTTPServer((bind_address, port), Handler).serve_forever()


if __name__ == "__main__":
    main()
