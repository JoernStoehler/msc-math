digraph ResearchNight {
  graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="MOCK research night | 5 October | Berlin time\nIllustrative outcomes; conditional later work. Quota: 99% available, phase use unknown.", nodesep=0.32, ranksep=0.6, pad=0.35];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#8693a4", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.10"];
  edge [color="#738294", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];
  t0 [shape=plaintext, style="", label="00:15"];
  t1 [shape=plaintext, style="", label="00:40"];
  t2 [shape=plaintext, style="", label="01:00"];
  t3 [shape=plaintext, style="", label="02:00–02:15"];
  t4 [shape=plaintext, style="", label="02:15–03:30"];
  t5 [shape=plaintext, style="", label="03:30–04:30"];
  t6 [shape=plaintext, style="", label="04:30–05:00"];
  t7 [shape=plaintext, style="", label="05:00"];
  t0 -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> t7 [color="#c0c7cf"];
  f [label="F11 exact replay\n+ endpoint audit\n00:15–01:00"];
  a [label="Extremality / equality ideas\nFirst derivation + falsifier\nSol 6.1 | 25 min"];
  b [label="Different geometry ideas\nConstruction + adverse control\nSol 6.1 | 25 min"];
  c [label="Compare actual returns\n00:40–01:00\nScientific integrator"];
  g [label="If supported:\nglobal inequality / reduction\n01:00–02:00"];
  l [label="If supported:\nlocal-maximum mechanism\n01:00–02:00"];
  d [label="If supported:\ndistinct discovery route\n01:00–02:00"];
  r [shape=diamond, fillcolor="#fff1d8", label="Check / reselect\n02:00–02:15"];
  h [label="Deepen 1–3 strong routes\nor replace weak routes\nAstra only for a concrete crux\n02:15–03:30"];
  p [label="Proof / separating examples\n+ independent review\n03:30–04:30"];
  i [label="Research integration\nEvidence + claim checks\n04:30–05:00"];
  z [shape=ellipse, fillcolor="#e4f0e4", label="Scheduled reset\n05:00"];
  alt [fillcolor="#f4f4f4", label="If returns are weak:\nreplace with another probe\n(no automatic fan-out)"];
  sup [fillcolor="#f0f0f0", label="Root + bounded supervisor: selection, actual liveness, value, quota, review backlog\n00:15–05:00 | scientific details remain with leaf owners"];
  {rank=same; t0; f; a; b; sup;}
  {rank=same; t1; c;}
  {rank=same; t2; g; l; d; alt;}
  {rank=same; t3; r;}
  {rank=same; t4; h;}
  {rank=same; t5; p;}
  {rank=same; t6; i;}
  {rank=same; t7; z;}
  a -> c; b -> c; f -> r [label="accepted or exact gap"];
  c -> g; c -> l; c -> d; c -> alt [style=dashed];
  g -> r; l -> r; d -> r; alt -> r;
  r -> h [label="useful reduction / counterexample"];
  h -> p -> i -> z;
  sup -> i [style=dotted, constraint=false, label="continuous supervision"];
}
