digraph tasks {
  graph [rankdir=BT, label="msc-math outcomes (see numbered details)", labelloc=t];
  node [shape=box];
  pass [label="PROJECT OUTCOME: PASS"];
  external [label="CRUX: external outcome\nsee 41-assessment", shape=diamond];
  submit [label="OUTCOME: valid submission"];
  ready [label="OUTCOME: PASS-ready candidate"];
  human [label="CRUX: Jorn review\nsee 12-review", shape=diamond];
  route [label="CRUX: replacement + pilot selection\nsee 00-now", shape=diamond];
  draft [label="INPUT: research + retained TOC"];
  official [label="CRUX: official status now\nsee 40-delivery", shape=diamond];
  conditional [label="RUNNING: DS readiness, opportunity audit, ledger\nsee 23; root fan-in"];

  draft -> route;
  route -> human [label="candidate produced"];
  conditional -> route [style=dashed, label="triggered repair"];
  human -> ready [label="PASS-ready"];
  human -> route [label="revise"];
  ready -> submit;
  official -> submit [label="pending"];
  official -> external [label="already submitted"];
  submit -> external;
  external -> pass [label="pass"];
}
