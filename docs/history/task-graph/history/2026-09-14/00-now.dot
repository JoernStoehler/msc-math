digraph now {
  graph [rankdir=BT, label="Current work: PASS approval target 18:00 Berlin, September 14", labelloc=t];
  node [shape=box];
  useful [label="OUTCOME: readable complete thesis PDF\nJorn judges PASS"];
  diagnosis [label="AVAILABLE: thesis + DS diagnoses\nattributed evidence; not blanket Jorn endorsement"];
  experiments [label="DONE: 3 pilots + independent reviews\npositive CEM; mixed heights; rotation loses\nmaintained wave report owns evidence"];
  hko [label="DONE: HKO mathematical inputs + review\n40-coordinate derivative; 26 exact sections\n4-page preview checked; theorem status retained"];
  sample [label="DONE: fixed sample feedback\ncomfortable prose; narrative objection\nAstra prediction missed principal objection"];
  compose [label="RUNNING: w2:p1 manuscript coordinator\nfixed 86-page revised snapshot under human review\nHKO lemmas/figures/CAS + literature integrated"];
  ds [label="DONE: DS ownership folded into coordinator\nopening-v2 integrated; evidence preserved\nno merge or independent run remains"];
  review [label="CRUX: whole prose meets human standard?\nHKO draft judged PASS; requested additions complete\nabstract/intro revised; no whole-thesis approval",shape=diamond];
  revise [label="IF objections: revise writing operation\ncheck on another actual passage"];
  check [label="REMAINS: resolve actual prose objections\ncheck changes and obtain whole-PDF judgment\nno whole-thesis PASS yet"];
  diagnosis -> compose;
  experiments -> compose;
  hko -> compose;
  sample -> review;
  review -> compose [label="useful calibration",style=dashed];
  review -> revise [label="missed human objections"];
  revise -> compose [style=dashed];
  ds -> check;
  compose -> check;
  check -> useful;
}
