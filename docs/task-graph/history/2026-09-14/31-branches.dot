digraph branches {
  graph [rankdir=BT, label="31 / unmerged branch outcomes", labelloc=t];
  node [shape=box];
  review [label="CRUX: review + integration", shape=diamond];
  merge [label="OUTCOME: approve + merge"];
  revise [label="OUTCOME: retain useful subset"];
  reject [label="OUTCOME: reject"];
  candidates [label="CANDIDATES: 149c6f57 evidence;\n1d0b2576 contracts; 88d1fad7 refactor"];
  dropped [label="DROPPED: 83ee0588 combined integration\ndo not merge; informs route split"];
  candidates -> review;
  review -> merge [label="correct + valuable"];
  review -> revise [label="partial"];
  review -> reject [label="wrong/not worth cost"];
  revise -> review;
  dropped -> reject;
}
