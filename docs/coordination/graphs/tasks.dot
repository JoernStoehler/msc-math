  "__completed" -> "__parked" [constraint=false, style=dashed, color="#a9a9a5"];
  "workflow-selection" -> "workflow-communication-acceptance";
  "__parked" -> "__completed" [style=invis];
  { rank=max; "workflow-done"; }
