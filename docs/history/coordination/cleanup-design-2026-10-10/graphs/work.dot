digraph work {
rankdir=TB;
graph [fontname="sans-serif", bgcolor="transparent", pad="0.2", nodesep="0.24", ranksep="0.42"]; node [shape=box, style="rounded,filled", fillcolor="#e4f1f6", color="#387084", fontname="sans-serif", fontsize=12, margin="0.13,0.10"]; edge [color="#70818b", arrowsize=0.65, fontname="sans-serif", fontsize=10];
subgraph cluster_g { label="GEOMETRY · Sol manager"; color="#b8ced8";
