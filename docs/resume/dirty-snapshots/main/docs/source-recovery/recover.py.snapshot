#!/usr/bin/env python3
"""Recover the recorded frozen candidate; refuse changed or missing inputs.

This one-time migration reads the old build records. Building the recovered
candidate does not use this script or the old source directories.
"""
import argparse
import hashlib
import json
import re
import shutil
import subprocess
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("repository", type=Path)
args = parser.parse_args()
root = args.repository.resolve()
destination = root / "thesis/candidate"
evidence = root / "docs/source-recovery/evidence"
record_dir = root / ".git/codex/thesis-candidate/build"
frozen = evidence / "frozen.pdf"
expected_pdf = "d7dae9a78dffc87fe89f3005bed9b6b51d28728fa90e1a5c811bc09b236e1695"

def digest(path, algorithm="sha256"):
    return hashlib.new(algorithm, path.read_bytes()).hexdigest()

def mapped(old):
    if old == ".git/codex/thesis-candidate/main.tex":
        return "main.tex"
    if old.startswith(".git/codex/"):
        return "recovered/" + old.removeprefix(".git/codex/")
    if old.startswith("thesis/"):
        return "legacy/" + old.removeprefix("thesis/")
    raise ValueError(f"Unrecognized project input: {old}")

records = {}
for line in (record_dir / "main.fdb_latexmk").read_text().splitlines():
    match = re.match(r'  "([^"]+)"\s+\S+\s+\d+\s+([0-9a-f]{32})\s', line)
    if not match:
        continue
    path = Path(match[1])
    if not path.is_absolute():
        path = root / "thesis" / path
    if path.is_relative_to(root) and not path.is_relative_to(record_dir):
        records[path.relative_to(root).as_posix()] = match[2]

# Cross-check recorder closure; Biber's bibliography inputs are in the FDB.
fls_inputs = set()
for line in (record_dir / "main.fls").read_text().splitlines():
    if line.startswith("INPUT "):
        path = Path(line.removeprefix("INPUT "))
        if not path.is_absolute():
            path = root / "thesis" / path
        if path.is_relative_to(root) and not path.is_relative_to(record_dir):
            fls_inputs.add(path.relative_to(root).as_posix())
assert fls_inputs <= records.keys(), sorted(fls_inputs - records.keys())
assert set(records) - fls_inputs == {
    "thesis/bibliography.bib", ".git/codex/thesis-candidate/additional.bib"
}
assert digest(frozen) == expected_pdf
assert digest(record_dir / "main.pdf") == expected_pdf
for old, md5 in records.items():
    assert digest(root / old, "md5") == md5, f"Changed frozen input: {old}"

tracked = set(subprocess.check_output(
    ["git", "ls-files", "-z"], cwd=root).decode().split("\0"))
command = re.compile(
    r'(\\(?:input|includegraphics|lstinputlisting|addbibresource)'
    r'(?:\[[^\]]*\])?\s*\{)([^}]+)(\})')
entries = []
for old, md5 in sorted(records.items()):
    source = root / old
    relative = mapped(old)
    target = destination / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    changes = []
    original = source.read_bytes()
    recovered = original
    if source.suffix == ".tex":
        def rewrite(match):
            arg = match[2]
            normalized = arg.removeprefix(str(root) + "/")
            if normalized.startswith(".git/codex/"):
                new_arg = mapped(normalized)
                changes.append({"old": arg, "new": new_arg})
                return match[1] + new_arg + match[3]
            return match[0]
        recovered = command.sub(rewrite, original.decode()).encode()
    # This script performs a mechanical path migration, never a prose edit.
    if target.exists() and target.read_bytes() != recovered:
        raise RuntimeError(f"Refusing to overwrite edited recovery: {target}")
    target.write_bytes(recovered)
    kind = {".tex": "latex-source", ".bib": "bibliography",
            ".py": "listed-cas-source", ".pdf": "figure",
            ".png": "figure"}[source.suffix]
    entries.append({
        "old": old, "new": "thesis/candidate/" + relative,
        "category": kind, "needed_for_pdf_build": True,
        "old_tracked": old in tracked, "bytes_before": len(original),
        "recorded_md5": md5, "current_md5_matches_record": True,
        "old_sha256": hashlib.sha256(original).hexdigest(),
        "new_sha256": hashlib.sha256(recovered).hexdigest(),
        "path_rewrites": changes,
    })

# Small hidden producer/provenance files accompany the direct build closure.
# Kept verbatim as historical support, not executed by the PDF build.
support = [
    ".git/codex/hko-figures/make_figures.py",
    ".git/codex/hko-figures/README.md",
    ".git/codex/hko-cas-appendix/README.md",
    ".git/codex/hko-writing-input/exact-fixed-values.json",
]
for old in support:
    target = destination / "support" / old.removeprefix(".git/codex/")
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists() and target.read_bytes() != (root / old).read_bytes():
        raise RuntimeError(f"Refusing to overwrite edited support: {target}")
    shutil.copy2(root / old, target)
    entries.append({
        "old": old, "new": target.relative_to(root).as_posix(),
        "category": "historical-generator-or-provenance",
        "needed_for_pdf_build": False, "old_tracked": old in tracked,
        "old_sha256": digest(root / old), "new_sha256": digest(target),
        "recorded_md5": None,
        "note": "Not a recorded PDF input; not freeze-verified or executed.",
    })

evidence.mkdir(parents=True, exist_ok=True)
for name in ("main.fls", "main.fdb_latexmk"):
    shutil.copy2(record_dir / name, evidence / ("frozen-" + name))
manifest = {
    "frozen_pdf_sha256": expected_pdf,
    "recorded_working_directory": str(root / "thesis"),
    "direct_build_input_count": len(records),
    "direct_build_input_bytes_before_rewrite": sum(
        entry["bytes_before"] for entry in entries if entry["needed_for_pdf_build"]),
    "migration": "Only TeX dependency command arguments changed; all other bytes preserved.",
    "records": {name: digest(evidence / name) for name in
                ("frozen-main.fls", "frozen-main.fdb_latexmk", "frozen.pdf")},
    "files": entries,
}
(root / "docs/source-recovery/dependency-manifest.json").write_text(
    json.dumps(manifest, indent=2) + "\n")
print(json.dumps({"recovered_inputs": len(records), "support_files": len(support),
                  "frozen_input_checks": "all match", "destination": str(destination)}))
