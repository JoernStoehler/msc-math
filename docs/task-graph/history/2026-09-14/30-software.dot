digraph software {
  graph [rankdir=BT, label="30 / calculation-path outcomes", labelloc=t];
  node [shape=box];
  usable [label="OUTCOME: trusted maintainable paths"];
  paths [label="DISTINCT CONSUMER PATHS:\nscalar / finite window / minimizers"];
  shared [label="SHARE ONLY ALIGNED CONTRACTS:\nsigma / KKT / geometry"];
  branches [label="Candidate work\nsee 31-branches"];
  trust [label="Route-specific evidence\nsee 32-trust"];
  branches -> shared -> paths -> trust -> usable;
}
