digraph trust {
  graph [rankdir=BT, label="32 / testing and evidence outcomes", labelloc=t];
  node [shape=box];
  trusted [label="BOUNDED TRUST STATEMENT"];
  review [label="CRUX: relevant checks", shape=diamond];
  pass [label="SUPPORTED"];
  fail [label="DEFECT FOUND"];
  indeterminate [label="INSUFFICIENT\nadd/narrow/drop"];
  tiers [label="smoke; anchors; invariants; correspondence;\nreconstruction; proof packets"];
  tiers -> review;
  review -> pass;
  review -> fail;
  review -> indeterminate;
  pass -> trusted;
}
