digraph reproducibility {
  graph [rankdir=BT, label="35 / reproducibility outcomes", labelloc=t];
  node [shape=box];
  ready [label="DEFENSIBLE REPRO BOUNDARY"];
  audit [label="CRUX: source-to-output audit", shape=diamond];
  identical [label="BYTE-IDENTICAL"];
  accepted [label="EXPLAINED DIFFERENCE"];
  missing [label="MISSING INPUT/TOOL\ncaveat or repair"];
  inputs [label="Inputs: producer route; versions; provenance;\nfigure/PDF copy chain; timings"];
  inputs -> audit;
  audit -> identical [label="reproduces"];
  audit -> accepted [label="expected drift"];
  audit -> missing [label="gap"];
  identical -> ready;
  accepted -> ready;
}
