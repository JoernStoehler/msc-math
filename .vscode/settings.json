{
	"git.autoRepositoryDetection": "openEditors",
	"git.ignoreLimitWarning": true,
	"files.autoSave": "off",
	"editor.wordWrap": "on",
	// texlab + chktex: disabled 2026-02-17.
	// chktex warnings are noise during active development — agents use
	// latexmk on the command line. Re-enable for a final style pass
	// before thesis submission.
	// "texlab.chktex.onOpenAndSave": true,
	// "texlab.chktex.onEdit": false,
	// "texlab.diagnostics.ignoredPatterns": [
	// 	"Overfull \\\\hbox",
	// 	"Underfull \\\\hbox"
	// ],
	// "texlab.experimental.ignoreFolders": [
	// 	"papers/"
	// ],
	"[markdown]": {
		"editor.tabSize": 2
	},
	"claudeCode.allowDangerouslySkipPermissions": true,
	"claudeCode.hideOnboarding": true,
	"claudeCode.initialPermissionMode": "bypassPermissions",
	"claudeCode.preferredLocation": "panel",
	"claudeCode.respectGitIgnore": false,
	"claudeCode.useCtrlEnterToSend": true,
	"workbench.editor.wrapTabs": true,
	"workbench.editor.showTabs": "multiple"
}
