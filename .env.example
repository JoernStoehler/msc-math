# Copy to .env, keep mode 0600, and adjust absolute host paths if needed.
DEVELOPER_UID=1000
DEVELOPER_GID=1000

CODEX_HOME_HOST=/projects/msc-math/mnt-home-codex
GH_HOME_HOST=/projects/msc-math/mnt-home-gh

WORKSPACE_IMAGE=msc-math-workspace:local
WORKSPACE_RAM_LIMIT=10g
WORKSPACE_RAM_PLUS_SWAP_LIMIT=10g
WORKSPACE_PIDS_LIMIT=16384
CARGO_BUILD_JOBS=4
CODEX_APP_SERVER_HOST_PORT=4500

BUILDX_BUILDER=msc-math-builder
