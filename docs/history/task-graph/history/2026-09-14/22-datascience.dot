digraph datascience {
  graph [rankdir=BT, label="22 / data science: useful starts", labelloc=t];
  node [shape=box];
  review [label="DONE: Astra review\nchapter viable; search open"];
  starts [label="DONE: first reports + adapter\nRUNNING:2 small pilots;see23\n22-next-actions.md"];
  scope [label="CRUX: first-hour evidence\nroot selects feasible pilots", shape=diamond];
  extend [label="NEXT: diverse pilots, ~3h\nmeasured budget"];
  partial [label="PARTIAL / FAIL / TIMEOUT\nblocker + viable subset"];
  retain [label="READY: chapter evidence\nenrichment + limits"];
  fanin [label="RESERVE: ~1h consolidation\nresults inform next decision"];
  review -> starts -> scope;
  scope -> extend [label="enabled"];
  scope -> partial [label="limited"];
  extend -> fanin;
  partial -> fanin;
  retain -> fanin [style=dashed];
}
