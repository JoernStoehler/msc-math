\begin{document}
\begin{center}
{\Large The capacity of a rotated pentagon product}\\[5pt]
{\small An analytic proof using the known HKO capacity}
\end{center}

Let $P\subset\mathbb R^2$ be a regular pentagon centred at the origin with
circumradius one. Write $R_\theta$ for planar rotation through $\theta$, and set
\[
K_\theta=P\times R_\theta P\subset\mathbb R_q^2\times\mathbb R_p^2.
\]
The ambient symplectic form is
$\omega((q,p),(q',p'))=q\cdot p'-p\cdot q'$.

\begin{theorem}
For $-\pi/10\leq\theta\leq\pi/10$,
\[
c_{\mathrm{EHZ}}(K_\theta)
=\frac{(1+\cos(\pi/5))^2}{\cos\theta}.
\]
\end{theorem}

\textbf{The capacity formula we use.}
Write the pentagon as $P=\{q:u_i\cdot q\leq1,\ 0\leq i<5\}$.
The ten facet covectors of the product are
\[
a_i(\theta)=(u_i,0),\qquad
a_{i+5}(\theta)=(0,R_\theta u_i)\qquad(0\leq i<5).
\]
Choose an ordering $\sigma$ of these ten facets and weights
$\beta_0,\ldots,\beta_9\geq0$ satisfying
\[
\sum_{i=0}^9\beta_i=1,
\qquad \sum_{i=0}^9\beta_i a_i(\theta)=0.
\]
For this choice, the quadratic objective is the number
\[
Q_{\sigma,\beta}(\theta)
=\sum_{0\leq j<k\leq9}
\beta_{\sigma(j)}\beta_{\sigma(k)}
\,\omega\bigl(a_{\sigma(j)}(\theta),a_{\sigma(k)}(\theta)\bigr).
\]
Haim--Kislev's formula expresses capacity in terms of the largest such number:
\[
c_{\mathrm{EHZ}}(K_\theta)
=\frac{1}{2\displaystyle\max_{\sigma,\beta}Q_{\sigma,\beta}(\theta)}.
\]
We will bound the objective for every ordering and every feasible set of
weights, then exhibit one choice attaining the bound.

\textbf{How a fixed choice varies under rotation.}
The closure condition splits into
\[
\sum_{i=0}^4\beta_i u_i=0,
\qquad R_\theta\sum_{i=0}^4\beta_{i+5}u_i=0.
\]
Since $R_\theta$ is invertible, the feasible weights do not depend on $\theta$.
Thus we can keep the ordering and weights fixed while varying the angle.
Pairings within either factor vanish; each mixed pairing is a scalar product
with $R_\theta$. Consequently, for constants depending on this fixed choice,
\[
Q_{\sigma,\beta}(\theta)=A\cos\theta+B\sin\theta.
\]

\newpage
\textbf{Bounding every choice from its values at the HKO angles.}
The bodies at angles $-\pi/10$ and $\pi/10$ have the known HKO capacity
\[
c_{\mathrm{HKO}}=2\cos(\pi/10)(1+\cos(\pi/5)).
\]
Indeed, the HKO angle $-\pi/2$ differs from $-\pi/10$ by a pentagon symmetry;
simultaneous reflection of both factors identifies the two endpoint capacities.
By the capacity formula, every fixed feasible choice therefore satisfies
\[
Q_{\sigma,\beta}(-\pi/10)\leq\frac{1}{2c_{\mathrm{HKO}}},
\qquad
Q_{\sigma,\beta}(\pi/10)\leq\frac{1}{2c_{\mathrm{HKO}}}.
\]
Because its objective has the form $A\cos\theta+B\sin\theta$, it satisfies
the trigonometric interpolation identity
\begin{align*}
Q_{\sigma,\beta}(\theta)
={}&\frac{\sin(\pi/10-\theta)}{\sin(\pi/5)}
Q_{\sigma,\beta}(-\pi/10)\\
&+\frac{\sin(\pi/10+\theta)}{\sin(\pi/5)}
Q_{\sigma,\beta}(\pi/10).
\end{align*}
Throughout $[-\pi/10,\pi/10]$, both coefficients are nonnegative. Substituting
the endpoint bounds and adding the two coefficients gives
\[
Q_{\sigma,\beta}(\theta)
\leq\frac{\cos\theta}{2c_{\mathrm{HKO}}\cos(\pi/10)}
=\frac{\cos\theta}{2(1+\cos(\pi/5))^2}.
\]
The last equality uses $2\cos^2(\pi/10)=1+\cos(\pi/5)$.
This bound holds for every feasible choice, hence for their maximum. Taking
the reciprocal in the capacity formula proves
\[
c_{\mathrm{EHZ}}(K_\theta)
\geq\frac{(1+\cos(\pi/5))^2}{\cos\theta}.
\]

\textbf{Attaining the bound.}
The thesis already supplies a single feasible choice whose objective is
\[
Q_{\sigma,\beta}(\theta)
=\frac{\cos\theta}{2(1+\cos(\pi/5))^2}.
\]
For completeness, label the planar facet covectors by
$u_i=(\cos(\pi/2+2\pi i/5),\sin(\pi/2+2\pi i/5))/\cos(\pi/5)$.
Use the facet order $(3,8,1,0,5,6)$, with respective weights
\[
\left(\frac{\sqrt5}{10},\frac{\sqrt5}{10},
\frac{5-\sqrt5}{20},\frac{5-\sqrt5}{20},
\frac{5-\sqrt5}{20},\frac{5-\sqrt5}{20}\right).
\]
The other four weights are zero. Direct substitution verifies closure,
normalization, and the displayed objective. Thus the maximum attains the
bound, proving the theorem.\hfill$\square$

\smallskip
{\small\textit{Provenance and scope.} The interpolation argument was supplied
by the Pro review. It uses the known HKO capacity and the explicit feasible
choice already in the thesis. Pentagon and factor-exchange symmetries extend
this interval formula to all relative angles. Since volume is constant,
the HKO angles maximize the systolic ratio in this family.}
