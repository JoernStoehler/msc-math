#!/usr/bin/env python3

"""Serve an explicit set of local artifacts for short-lived browser review."""

import html
import mimetypes
import pathlib
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit


STYLE = """
<style>
  :root { color-scheme: light dark; }
  body {
    box-sizing: border-box;
    max-width: 860px;
    margin: 2.5rem auto;
    padding: 0 2rem 4rem;
    color: light-dark(#202124, #e8eaed);
    background: light-dark(#fff, #202124);
    font: 16px/1.55 system-ui, sans-serif;
  }
  nav {
    position: sticky;
    top: 0;
    padding: .65rem 0;
    border-bottom: 1px solid light-dark(#dadce0, #5f6368);
    background: light-dark(#fff, #202124);
  }
  nav a { margin-right: 1rem; }
  h1, h2, h3 { line-height: 1.25; }
  pre, code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
  pre {
    padding: 1rem;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    border-radius: 6px;
    background: light-dark(#f6f8fa, #292a2d);
  }
</style>
"""


def markdown_page(path: pathlib.Path, raw: bool) -> bytes:
    source = path.read_text(encoding="utf-8")
    title = html.escape(path.name)
    nav = '<nav><a href="?">Rendered</a><a href="?raw=1">Raw source</a></nav>'
    if raw:
        document = (
            f"<!doctype html><html><head><meta charset='utf-8'>"
            f"<title>Raw — {title}</title>{STYLE}</head>"
            f"<body>{nav}<pre>{html.escape(source)}</pre></body></html>"
        )
        return document.encode()

    rendered = subprocess.run(
        [
            "pandoc",
            "--standalone",
            "--from=gfm-raw_html",
            "--to=html5",
            "--metadata",
            f"title={path.name}",
            str(path),
        ],
        check=True,
        stdout=subprocess.PIPE,
    ).stdout.decode("utf-8")
    rendered = rendered.replace("</head>", STYLE + "</head>")
    rendered = rendered.replace("<body>", "<body>" + nav, 1)
    return rendered.encode()


class Handler(BaseHTTPRequestHandler):
    files: list[pathlib.Path] = []
    token = ""

    def do_GET(self) -> None:
        request = urlsplit(self.path)
        parts = request.path.strip("/").split("/")
        if parts == [self.token, "health"]:
            self.send_response(204)
            self.end_headers()
            return
        if len(parts) != 2 or parts[0] != self.token or not parts[1].isdigit():
            self.send_error(404)
            return
        index = int(parts[1])
        if index >= len(self.files):
            self.send_error(404)
            return

        path = self.files[index]
        suffix = path.suffix.lower()
        try:
            if suffix in {".md", ".markdown"}:
                body = markdown_page(path, "raw" in parse_qs(request.query))
                mime = "text/html; charset=utf-8"
            else:
                body = path.read_bytes()
                mime = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
                if mime.startswith("text/"):
                    mime += "; charset=utf-8"
        except (OSError, UnicodeError, subprocess.SubprocessError) as error:
            self.send_error(500, explain=str(error))
            return

        self.send_response(200)
        self.send_header("Content-Type", mime)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Disposition", f'inline; filename="{path.name}"')
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        pass


def main() -> None:
    if len(sys.argv) < 5:
        raise SystemExit("usage: review-server BIND_ADDRESS PORT TOKEN FILE...")
    bind_address = sys.argv[1]
    port = int(sys.argv[2])
    Handler.token = sys.argv[3]
    Handler.files = [pathlib.Path(name).resolve(strict=True) for name in sys.argv[4:]]
    ThreadingHTTPServer((bind_address, port), Handler).serve_forever()


if __name__ == "__main__":
    main()
